{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "medicine316",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "goodnews316-db",
			"database_id": "61726df9-f6a7-4b61-b1c5-0a05127d08b4",
			"remote": true
		}
	]
}
