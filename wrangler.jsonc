{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "medicine316",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"workers_dev": true,
	"preview_urls": true,

	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "goodnews316-db",
			"database_id": "a6eb9106-ea39-4e97-afb1-65fcce844272",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "goodnews316-bucket",
			"binding": "BUCKET",
			"remote": true
		}
	]
}
